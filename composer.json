{
    "name": "stevenpaw/silverstripe-sociallink",
    "description": "A small module for adding social links to silverstripe linkfields",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.1",
        "silverstripe/cms": "^6",
        "silverstripe/versioned": "^3",
        "silverstripe/linkfield": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Stevenpaw\\SocialLink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stevenpaw\\SocialLink\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
